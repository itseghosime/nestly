# Nestly — Environment template (no secrets committed)
# Copy to .env.local and fill from your Supabase project + n8n + provider dashboards.
# See docs/BACKEND_CHECKLIST.md for which variables gate live verification.

# ── Demo mode (explicit only; never silent fallback) ──
# Set to 'true' only for local UI fixture fallback; protected APIs still require real staff auth.
NEXT_PUBLIC_DEMO_MODE=false

# ── Supabase (required for Phase A) ──
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never NEXT_PUBLIC_, never shipped to browser
SUPABASE_SERVICE_ROLE_KEY=
# Optional CLI-only database password for remote schema dump/pull commands.
# Do not share or commit its value; the application does not use this variable.
SUPABASE_DB_PASSWORD=
# Canonical app origin used by Auth callback generation and same-origin request checks.
# Local app testing: http://localhost:3000. Production must use the real deployed HTTPS origin.
# Supabase Auth Redirect URLs must include the exact /auth/callback URLs generated for invite/recovery.
NEXT_PUBLIC_SITE_URL=
# Server-only HMAC key for deterministic, opaque offer/inspection receipt tokens (at least 32 bytes)
PUBLIC_RECEIPT_HMAC_SECRET=

# ── WhatsApp (Twilio inbound relay) ──
# Server-only Twilio Auth Token; never expose with a NEXT_PUBLIC_ prefix.
TWILIO_AUTH_TOKEN=
# Staff-initiated API sends stay disabled unless this is exactly 'true'.
TWILIO_OUTBOUND_ENABLED=false
# Must exactly match the HTTPS callback URL configured in Twilio; localhost is not public.
TWILIO_PUBLIC_WEBHOOK_URL=
# Outbound staff replies use the Twilio WhatsApp Sandbox sender configured in Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_FROM=
# Exact public HTTPS app URL ending in /api/twilio/whatsapp/status; message_id is appended per send.
TWILIO_STATUS_CALLBACK_URL=
# Existing WF01 production Webhook URL. Server-only.
NESTLY_WF01_WEBHOOK_URL=
# Random server-only relay secret shared with the WF01 Webhook Header Auth credential.
NESTLY_WF01_RELAY_SECRET=

# ── WhatsApp (Meta Cloud API) — deferred ──
# Configure only after Meta verification and a separate approved provider cutover.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── n8n (orchestration/retries) ──
# Base webhook URL for enqueuing after dedup, e.g. https://n8n.example.com/webhook/nestly
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── Nia provider (AI) — reuse existing model/budget, configurable via workspace_settings ──
NIA_PROVIDER=
NIA_MODEL=
NIA_TOKEN_BUDGET=
NIA_COST_CAP_NGN=

# ── Email (Resend) — Phase D notifications ──
RESEND_API_KEY=

# ── Test allowlists (never send to real customers) ──
# Comma-separated E.164 numbers that may receive test WA messages
WHATSAPP_TEST_RECIPIENTS=

# ── Optional Supabase integration tests (use a disposable development project only) ──
# Keep these separate from application configuration. The service-role value is only for isolated
# test identity setup/cleanup; authorization assertions use anon and authenticated user clients.
# For a local Supabase stack, `npm run test:supabase:local` obtains these values without printing them.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
